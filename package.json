{
  "name": "vlauncher",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Um launcher para os projetos em que você trabalha: grupos com foto, variações de como rodar cada app e a escolha da branch ou da worktree antes de rodar. Windows, Tauri 2.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "app": "tauri dev",
    "app:build": "tauri build",
    "tauri": "tauri",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
